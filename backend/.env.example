# Copy to .env and fill in. Never commit .env.

APP_ENV=dev
CORS_ORIGINS=http://localhost:5173

# Storage: sqlite (default, file DB_PATH) | dynamodb (platform account, target storage)
STORAGE_BACKEND=sqlite
DB_PATH=./autoaws.db
DYNAMODB_TABLE=autoaws
DYNAMODB_REGION=
# Dev only: LocalStack, e.g. http://localhost:4566 (independent of AWS_ENDPOINT_URL)
DYNAMODB_ENDPOINT_URL=
# Create the table + indexes on startup if missing (set false when IaC owns the table)
DYNAMODB_CREATE_TABLE=true
# Customer managed KMS key for table encryption (empty = AWS managed key aws/dynamodb)
DYNAMODB_KMS_KEY_ID=

# LLM provider: mock | anthropic | bedrock | mcp   (mock needs no key)
#   mcp = an MCP client (e.g. Claude Code) plays the LLM through http://localhost:8000/mcp/
#         claude mcp add --transport http autoaws-llm http://localhost:8000/mcp/
LLM_PROVIDER=mock
MCP_BRIDGE_TIMEOUT_SECONDS=900
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
BEDROCK_MODEL_ID=
BEDROCK_REGION=

# Platform AWS account (only needed for connections of type "role").
# The platform credentials are read by boto3's default chain: AWS_PROFILE below,
# or AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY, or ~/.aws/credentials.
PLATFORM_AWS_ACCOUNT_ID=
PLATFORM_AWS_PROFILE=

# Dev only: send every AWS call to LocalStack instead of real AWS (see infra/localstack/)
AWS_ENDPOINT_URL=
# Resolvers used by resolve_dns_public (comma-separated IPs)
DNS_RESOLVERS=8.8.8.8,1.1.1.1

# Agent
MAX_AGENT_ITERATIONS=8
