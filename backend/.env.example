# Copy to .env and fill in. Never commit .env.

APP_ENV=dev
DB_PATH=./autoaws.db
CORS_ORIGINS=http://localhost:5173

# LLM provider: mock | openai | bedrock | anthropic (anthropic is not implemented).
# Use openai for any OpenAI-compatible Chat Completions server, including Ollama.
# mock remains the no-server default for testing the pipeline.
LLM_PROVIDER=mock

# Ollama: start the server, pull a tool-capable model, then set LLM_PROVIDER=openai.
# Use the exact name from `ollama list`; qwen3:8b is an example, not downloaded here.
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_MODEL=
# Optional for local Ollama; required by servers that enforce API-key authentication.
OPENAI_API_KEY=
OPENAI_TIMEOUT_SECONDS=120
OPENAI_MAX_TOKENS=4096
# Ollama/most compatible servers: max_tokens. Some OpenAI models: max_completion_tokens.
OPENAI_TOKEN_LIMIT_FIELD=max_tokens

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
BEDROCK_MODEL_ID=
BEDROCK_REGION=

# Platform credentials for AssumeRole and Bedrock. Loaded directly from this file;
# no AWS CLI, host profile or ~/.aws/credentials is required.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Required for temporary credentials (STS / AWS Academy); otherwise leave blank.
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=ap-southeast-1

# Required for role onboarding: 12-digit AWS account ID running AutoAWS.
# Published in connection setup and used in trust policies, not to authenticate.
PLATFORM_AWS_ACCOUNT_ID=
# Optional fallback only when no credentials above are set.
PLATFORM_AWS_PROFILE=

# Agent
MAX_AGENT_ITERATIONS=10
AGENT_DEMO_MODE=false
