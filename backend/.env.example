# Copy to .env and fill in. Never commit .env.

APP_ENV=dev
DB_PATH=./autoaws.db
CORS_ORIGINS=http://localhost:5173

# LLM provider: mock | anthropic | bedrock   (mock needs no key)
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
BEDROCK_MODEL_ID=
BEDROCK_REGION=

# Platform credentials for AssumeRole and Bedrock. Loaded directly from this file;
# no AWS CLI, host profile or ~/.aws/credentials is required.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Required for temporary credentials (STS / AWS Academy); otherwise leave blank.
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=ap-southeast-1

# Required for role onboarding: 12-digit AWS account ID running AutoAWS.
# Published in connection setup and used in trust policies, not to authenticate.
PLATFORM_AWS_ACCOUNT_ID=
# Optional fallback only when no credentials above are set.
PLATFORM_AWS_PROFILE=

# Agent
MAX_AGENT_ITERATIONS=10
AGENT_DEMO_MODE=false
