# Copy to .env and fill in. Never commit .env.

APP_ENV=dev
CORS_ORIGINS=*

# DynamoDB in the platform account. Fill from the CloudFormation stack outputs.
STORAGE_BACKEND=dynamodb
DYNAMODB_TABLE=
DYNAMODB_REGION=
# Leave empty for the regional AWS endpoint; set a URL only for a custom endpoint.
# LocalStack example: http://localhost:4566 (independent of AWS_ENDPOINT_URL)
DYNAMODB_ENDPOINT_URL=
# CloudFormation creates the table. Set true only for automatic dev/LocalStack setup.
DYNAMODB_CREATE_TABLE=false
# Used only when DYNAMODB_CREATE_TABLE=true; CloudFormation controls deployed encryption.
DYNAMODB_KMS_KEY_ID=

# LLM provider: mock | anthropic | bedrock | mcp   (mock needs no key)
#   mcp = an MCP client (e.g. Claude Code) plays the LLM through http://localhost:8000/mcp/
#         claude mcp add --transport http autoaws-llm http://localhost:8000/mcp/
LLM_PROVIDER=mock
MCP_BRIDGE_TIMEOUT_SECONDS=900
# bedrock: Claude on Amazon Bedrock via the anthropic SDK's Mantle client, platform account
# credentials (PLATFORM_AWS_PROFILE / default chain). Model ids carry the anthropic. prefix.
BEDROCK_MODEL_ID=anthropic.claude-opus-5-5
BEDROCK_REGION=
# Retry a refused request on this model (client-side); empty = off
BEDROCK_FALLBACK_MODEL=anthropic.claude-opus-4-8
# anthropic: Claude API (dev alternative)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Both Claude providers: thinking depth (low|medium|high|xhigh|max) and output cap
LLM_EFFORT=high
LLM_MAX_TOKENS=16000

# Sign-in (docs/API_CONTRACT.md §0.1): none = one local user (dev) | cognito = Bearer access
# token of the Cognito user pool (CDK Auth or infra/cloudformation/cognito.yaml outputs
# UserPoolId / WebClientId / HostedUiUrl; see infra/cloudformation/COGNITO.md)
AUTH_MODE=none
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_DOMAIN=

# Platform AWS account (only needed for connections of type "role").
# The platform credentials are read by boto3's default chain: AWS_PROFILE below,
# or AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY, or ~/.aws/credentials.
PLATFORM_AWS_ACCOUNT_ID=
PLATFORM_AWS_PROFILE=

# Dev only: send every AWS call to LocalStack instead of real AWS (see infra/localstack/)
AWS_ENDPOINT_URL=
# Resolvers used by resolve_dns_public (comma-separated IPs)
DNS_RESOLVERS=8.8.8.8,1.1.1.1

# Agent limits per diagnosis turn (docs/API_CONTRACT.md §3)
MAX_AGENT_ITERATIONS=10
# Wall-clock seconds (not applied to LLM_PROVIDER=mcp)
MAX_AGENT_SECONDS=240
# Input + output tokens, when the provider reports usage
MAX_TURN_TOKENS=200000
MAX_TOOL_CALLS=40
# Same tool + same input within this many seconds is served from the conversation cache (0 = off)
TOOL_CACHE_TTL_SECONDS=300
# Time zone the agent uses when talking about times
USER_TIMEZONE=Asia/Ho_Chi_Minh

# Human-in-the-loop remediation (docs/API_CONTRACT.md §7)
# Dev only: let ACCESS-KEY connections execute approved proposals (LocalStack, test accounts).
# Role connections use their AutoAWSRemediation role (CloudFormation EnableRemediation=true).
REMEDIATION_ALLOW_ACCESS_KEYS=false
PROPOSAL_TTL_HOURS=24
REMEDIATION_VERIFY_TIMEOUT_SECONDS=120

# Where background work runs (docs/API_CONTRACT.md §9): local (one process) | lambda
# The CDK stacks in infra/cdk set the lambda values; locally keep RUNTIME=local.
RUNTIME=local
JOB_TTL_DAYS=7
JOB_STALE_SECONDS=900
